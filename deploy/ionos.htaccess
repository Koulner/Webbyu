# IONOS/Apache only; copied into the production build, never the Pages preview.
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

# HTTPS is already provisioned at IONOS. Preserve paths and query strings;
# respect an HTTPS connection terminated by a reverse proxy/CDN as well.
RewriteEngine On
# Guard application/dependency sources even when a nested .htaccess is absent.
RewriteRule ^(?:_inquiry|backend|webbyu-private)(?:/|$) - [F,L,NC]

# Normalize real HTML pages only. THE_REQUEST distinguishes an explicit
# index.html URL from Apache's internal DirectoryIndex lookup.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+[^\s?]*index\.html(?:[?\s])
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^((?:[^/]+/)*)index\.html$ https://webbyu.de/$1 [R=301,L,NE]

# Use HTTPS even behind a proxy when adding the slash of an actual HTML page.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ https://webbyu.de/$1/ [R=301,L,NE]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://webbyu.de%{REQUEST_URI} [R=301,L,NE]

# Keep API methods and their response contract outside SEO host redirects.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{REQUEST_URI} !^/api(?:/|$) [NC]
RewriteCond %{HTTP_HOST} ^www\.webbyu\.de(?::[0-9]+)?$ [NC]
RewriteRule ^ https://webbyu.de%{REQUEST_URI} [R=301,L,NE]

# Vite's content-hashed assets are safe to cache across releases.
RewriteRule ^assets/[^/]+-[A-Za-z0-9_-]{8}\.(?:js|css|woff2?|avif|webp|png|jpe?g|svg)$ - [E=WEBBYU_HASHED:1]

<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|avif|webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
    Header set Cache-Control "public, max-age=31536000, immutable" env=WEBBYU_HASHED
  </FilesMatch>
  # Revalidate entry points after each deployment, including behind the CDN.
  <FilesMatch "\.(?:html|json|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  # Browsers that once saw HTTPS never fall back to a plain-HTTP redirect (no SSL stripping).
  # No includeSubDomains: other subdomains are not known to serve HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Only webbyu.de may frame its pages; src/shell.ts embeds its own demos and the journey.
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/xml image/svg+xml
  </IfModule>
</IfModule>

<FilesMatch "^\.webbyu-upload-">
  Require all denied
</FilesMatch>

<FilesMatch "^(?:\.env(?:\..*)?|composer\.(?:json|lock)|.*\.(?:ini|log))$">
  Require all denied
</FilesMatch>
