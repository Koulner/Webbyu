# IONOS/Apache only; copied into the production build, never the Pages preview.
DirectoryIndex index.html
Options -Indexes

<IfModule mod_headers.c>
  # Revalidate entry points after each deployment, including behind the CDN.
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

<FilesMatch "^\.webbyu-upload-">
  Require all denied
</FilesMatch>
